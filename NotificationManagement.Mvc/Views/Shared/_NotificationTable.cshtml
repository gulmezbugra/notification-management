@model IEnumerable<NotificationItemViewModel>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0 notification-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Receiver</th>
                <th>Message</th>
                <th>Type</th>
                <th>Status</th>
                <th>Created</th>
                <th>Sent</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-muted">#@item.Id</td>
                    <td class="fw-medium">@item.Receiver</td>
                    <td class="message-cell" title="@item.Message">@item.Message</td>
                    <td><partial name="_TypeBadge" model="item.Type" /></td>
                    <td><partial name="_StatusBadge" model="item.Status" /></td>
                    <td class="text-nowrap">@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td class="text-nowrap">@(item.SentAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                    <td class="text-end">
                        <a asp-controller="Notification" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i> View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
