@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isCreate = controller == "Notification" && action == "Create";
    var isHistory = controller == "Notification" && !isCreate;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NotifyHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <span class="brand-icon"><i class="bi bi-bell-fill"></i></span>
                <span>NotifyHub</span>
            </div>

            <nav class="nav flex-column sidebar-nav">
                <span class="nav-section">Menu</span>
                <a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(isHistory ? "active" : "")" asp-controller="Notification" asp-action="Index">
                    <i class="bi bi-clock-history"></i> Notifications
                </a>
                <a class="nav-link @(isCreate ? "active" : "")" asp-controller="Notification" asp-action="Create">
                    <i class="bi bi-send-plus"></i> New Notification
                </a>
            </nav>

            <div class="sidebar-footer">Factory Pattern Demo</div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="main-area">
            <header class="topbar">
                <button class="btn btn-light d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h1 class="topbar-title">@ViewData["Title"]</h1>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <a class="btn btn-primary btn-sm" asp-controller="Notification" asp-action="Create">
                        <i class="bi bi-plus-lg"></i> New
                    </a>
                    <span class="avatar">AD</span>
                </div>
            </header>

            <main class="content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
