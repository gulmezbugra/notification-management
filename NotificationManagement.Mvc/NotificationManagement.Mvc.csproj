      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotificationManagement.Core\NotificationManagement.Core.csproj" />
    <ProjectReference Include="..\NotificationManagement.Data\NotificationManagement.Data.csproj" />
    <ProjectReference Include="..\NotificationManagement.Business\NotificationManagement.Business.csproj" />
  </ItemGroup>

</Project>
