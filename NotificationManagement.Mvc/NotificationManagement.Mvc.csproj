<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>ce7bd3a7-f68f-40b5-8f08-5ad73199ef7d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed by the "dotnet ef" tool (startup project) -->
